rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user has a valid PIN
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get PIN data
    function getPinData() {
      return get(/databases/$(database)/documents/pins/$(request.auth.uid)).data;
    }
    
    // Helper function to check user role
    function hasRole(role) {
      return isAuthenticated() && getPinData().role == role;
    }

    // PINs collection - read only for authentication
    match /pins/{pinId} {
      allow read: if true; // Needed for PIN verification during login
      allow write: if false; // PRODUCTION: Only allow writes via server-side or Firebase console
    }

    // Faculties collection
    match /faculties/{facultyId} {
      allow read: if true; // Everyone can read faculties
      allow write: if false; // PRODUCTION: Only allow writes via server-side or Firebase console
    }

    // Participants collection
    match /participants/{participantId} {
      allow read: if true; // Everyone can read participants
      allow write: if false; // PRODUCTION: Only allow writes via server-side or Firebase console
    }

    // Events collection
    match /events/{eventId} {
      allow read: if true; // Everyone can read events
      allow write: if false; // PRODUCTION: Only allow writes via server-side or Firebase console
    }

    // Templates collection
    match /templates/{templateId} {
      allow read: if true; // Everyone can read templates
      allow write: if false; // PRODUCTION: Only allow writes via server-side or Firebase console
    }

    // Invigilators collection
    match /invigilators/{invigilatorId} {
      allow read: if true; // Everyone can read invigilators (needed for display)
      allow write: if false; // PRODUCTION: Only allow writes via server-side or Firebase console
    }

    // Assignments collection
    match /assignments/{assignmentId} {
      allow read: if true; // Everyone can read assignments
      allow write: if false; // PRODUCTION: Reserved for future admin features
    }

    // Scores collection
    match /scores/{scoreId} {
      // Everyone can read scores (for display screen)
      allow read: if true;
      
      // Only allow score creation with valid data structure
      // Validate that required fields are present and correct types
      allow create: if request.resource.data.keys().hasAll([
        'eventId', 'templateId', 'participantId', 'facultyId', 
        'invigilatorId', 'roundNumber', 'criteriaScores', 'total', 'timestamp'
      ]) && 
      request.resource.data.eventId is string &&
      request.resource.data.templateId is string &&
      request.resource.data.participantId is string &&
      request.resource.data.facultyId is string &&
      request.resource.data.invigilatorId is string &&
      request.resource.data.roundNumber is int &&
      request.resource.data.roundNumber > 0 &&
      request.resource.data.criteriaScores is list &&
      request.resource.data.total is number &&
      request.resource.data.total >= 0 &&
      request.resource.data.timestamp is number;
      
      // Prevent updates and deletes in production (scores should be immutable once submitted)
      allow update, delete: if false;
    }

    // Aggregates collection (for faculty totals)
    match /aggregates/{aggregateId} {
      allow read: if true; // Everyone can read aggregates
      allow write: if false; // PRODUCTION: Aggregates should be calculated, not manually updated
    }

    // Active Participants collection (for live participant selection)
    match /activeParticipants/{docId} {
      allow read: if true; // Everyone can read active participants (invigilators need this)
      // PRODUCTION: Only admin should be able to update active participants
      // For now allowing all writes, but consider adding admin role check
      allow write: if true; // TODO: Change to admin-only in production
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
